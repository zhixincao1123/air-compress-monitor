<Window x:Class="AirCompressMonitor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AirCompressMonitor.Wpf"
        xmlns:zxc="clr-namespace:AirCompressMonitor.Wpf.Control"
        mc:Ignorable="d"
        Title="空压机现场监控" Height="760" Width="820"
        AllowsTransparency="False"
        WindowStyle="None"
        Background="#f5f5f5" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <QuinticEase x:Key="QuinticEase" EasingMode="EaseOut"/>
        <local:AddOffsetConverter x:Key="Converter"/>
        <BooleanToVisibilityConverter x:Key="BoolToV"/>
        <Style x:Key="Watch" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowTitleStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="140"/>
            <Setter Property="FontSize" Value="35"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2c7edb"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="50 0 0 0"/>
        </Style>
        <Style x:Key="RowTitleStyle2" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#ffdb942c"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0 5 0 0"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0 0 4 0"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2c7edb"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0 0 16 0"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#2c7edb" CornerRadius="0" MouseLeftButtonDown="Border_MouseLeftButtonDown">
            <Grid>
                <TextBlock Text="Modbus 空压机监控"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="20,0"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0 0 10 0">
                    <Button Content="监控页" Width="80" Height="30"
                            Foreground="White" Background="#1967d2"
                            BorderThickness="0" Click="Button_SwitchWindow"/>
                    <Button Content="报警页" Width="80" Height="30"
                            Foreground="White" Background="#1967d2"
                            BorderThickness="0" Margin="2 0 0 0"
                            Click="Button_SwitchAlarm"/>
                    <Button Content="诊断页" Width="80" Height="30"
                            Foreground="White" Background="#1967d2"
                            BorderThickness="0" Margin="2 0 0 0"
                            Click="Button_SwitchDiagnosis"/>
                    <Button Content="从站页" Width="80" Height="30"
                            Foreground="White" Background="#1967d2"
                            BorderThickness="0" Margin="2 0 5 0"
                            Click="Button_SwitchSlave"/>
                    <Button Content="-" Width="25" Height="25"
                            Foreground="White" Background="Transparent"
                            BorderThickness="0" Click="Button_Minimize" FontSize="12"/>
                    <Button Content="X" Width="25" Height="25"
                            Foreground="White" Background="Transparent"
                            BorderThickness="0" FontSize="12" Click="Button_Exit"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" x:Name="MainTabControl" SelectedIndex="0"
                    VirtualizingStackPanel.IsVirtualizing="True"
                    VirtualizingStackPanel.VirtualizationMode="Recycling">

            <!-- ============ 监控页 ============ -->
            <TabItem Header="监控页">
                <Grid Margin="10">
                    <Border Background="White" Margin="8" CornerRadius="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="280"/>
                                <RowDefinition Height="180"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 通信统计条：让「界面稳定」有据可查 -->
                            <Border Grid.Row="0" Background="#f8fafc" Padding="12,6" CornerRadius="4" Margin="8,8,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="链路" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource StatValue}"/>
                                    <TextBlock Text="成功率" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding SuccessRateText}" Style="{StaticResource StatValue}"/>
                                    <TextBlock Text="延迟" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding LatencyText}" Style="{StaticResource StatValue}"/>
                                    <TextBlock Text="请求数" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding RequestText}" Style="{StaticResource StatValue}"/>
                                    <TextBlock Text="重连次数" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding ReconnectText}" Style="{StaticResource StatValue}"/>
                                    <TextBlock Text="字节序" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding EndianText}" Style="{StaticResource StatValue}"/>
                                    <TextBlock Text="存储" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding StoreText}" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                            </Border>

                            <!-- 三块表 -->
                            <Border Grid.Row="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="40"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="供气压力" Style="{StaticResource RowTitleStyle}" Margin="0,0,100,0"/>
                                        <TextBlock Text="A相电流" Style="{StaticResource RowTitleStyle}" Margin="0,0,0,0"/>
                                        <TextBlock Text="运行时间" Style="{StaticResource RowTitleStyle}" Margin="90,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <zxc:Meter Width="210" Height="210"
                                                   Minimum="0" Maximum="170" Value="{Binding PressureValue}" Unit="mpa"
                                                   Tip="Pressure" ScaleCount="20" FontFamily="Arial" Margin="0,0,30,0"/>
                                        <zxc:Meter Width="210" Height="210"
                                                   Minimum="0" Maximum="999.9" Value="{Binding Flow}" Unit="A"
                                                   Tip="电流" ScaleCount="20" FontFamily="Arial" Margin="0,0,30,0"/>
                                        <zxc:Meter Width="210" Height="210"
                                                   Minimum="0" Maximum="65535" Value="{Binding Time}" Unit="H"
                                                   Tip="TIME" ScaleCount="20" FontFamily="Arial"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 状态位 -->
                            <Border Grid.Row="2">
                                <Grid Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" Margin="10,5">
                                        <TextBlock Text="运行状态" VerticalAlignment="Center" Height="auto"
                                                   Foreground="#fff4362f" FontSize="30" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center">
                                        <zxc:LedLight Width="50" Height="50" IsOn="{Binding Bit0}" LightColor="LimeGreen"/>
                                        <TextBlock Text="加载/卸载" Style="{StaticResource RowTitleStyle2}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center">
                                        <zxc:LedLight Width="50" Height="50" IsOn="{Binding Bit1}" LightColor="LimeGreen"/>
                                        <TextBlock Text="运行/停止" Style="{StaticResource RowTitleStyle2}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="3" HorizontalAlignment="Center">
                                        <zxc:LedLight Width="50" Height="50" IsOn="{Binding Bit2}" LightColor="LimeGreen"/>
                                        <TextBlock Text="排气温度过高" Style="{StaticResource RowTitleStyle2}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="4" HorizontalAlignment="Center">
                                        <zxc:LedLight Width="50" Height="50" IsOn="{Binding Bit3}" LightColor="LimeGreen"/>
                                        <TextBlock Text="相序错误" Style="{StaticResource RowTitleStyle2}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center">
                                        <zxc:LedLight Width="50" Height="50" IsOn="{Binding Bit4}" LightColor="LimeGreen"/>
                                        <TextBlock Text="主电机电流故障" Style="{StaticResource RowTitleStyle2}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center">
                                        <zxc:LedLight Width="50" Height="50" IsOn="{Binding Bit5}" LightColor="LimeGreen"/>
                                        <TextBlock Text="空滤器堵塞" Style="{StaticResource RowTitleStyle2}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center">
                                        <zxc:LedLight Width="50" Height="50" IsOn="{Binding Bit6}" LightColor="LimeGreen"/>
                                        <TextBlock Text="风机电流故障" Style="{StaticResource RowTitleStyle2}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="3" HorizontalAlignment="Center">
                                        <zxc:LedLight Width="50" Height="50" IsOn="{Binding Bit7}" LightColor="LimeGreen"/>
                                        <TextBlock Text="供气压力过高" Style="{StaticResource RowTitleStyle2}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="4" HorizontalAlignment="Center">
                                        <zxc:LedLight Width="50" Height="50" IsOn="{Binding Bit8}" LightColor="LimeGreen"/>
                                        <TextBlock Text="油分气堵塞" Style="{StaticResource RowTitleStyle2}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 远程控制 -->
                            <StackPanel Grid.Row="3" Orientation="Horizontal"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,12">
                                <StackPanel Orientation="Vertical" Margin="0 0 40 0" HorizontalAlignment="Center">
                                    <Ellipse Width="25" Height="25" Stroke="Gray" StrokeThickness="1" Margin="0,0,10,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="Red"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CtrlB0}" Value="true">
                                                        <Setter Property="Fill" Value="LimeGreen"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <Button Command="{Binding ToggleStartStopCommand}" Width="120"
                                            Height="45" FontSize="14" FontWeight="Bold">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#2563eb"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="Content" Value="远程启动"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CtrlB0}" Value="true">
                                                        <Setter Property="Background" Value="#dc2626"/>
                                                        <Setter Property="Content" Value="远程停止"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <Ellipse Width="25" Height="25" Stroke="Gray" StrokeThickness="1" Margin="0 0 10 0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#e5e7eb"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CtrlB2}" Value="true">
                                                        <Setter Property="Fill" Value="#f59e0b"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CtrlB3}" Value="true">
                                                        <Setter Property="Fill" Value="#6366f1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <Button Command="{Binding ToggleLoadUnloadCommand}" Width="120" Height="45" FontSize="14"
                                            FontWeight="Bold">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#f97316"/>
                                                <Setter Property="Foreground" Value="white"/>
                                                <Setter Property="Content" Value="远程加载"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CtrlB2}" Value="true">
                                                        <Setter Property="Background" Value="#4f46e5"/>
                                                        <Setter Property="Content" Value="远程卸载"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ 报警页 ============ -->
            <TabItem Header="报警页">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <ListBox Grid.Row="0" ItemsSource="{Binding AlarmList}"
                             SelectedItem="{Binding SelectedAlarm}"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="5">
                                    <TextBlock Text="{Binding Time,StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="150"/>
                                    <TextBlock Text="{Binding SlaveName}" Width="90" Margin="10 0"/>
                                    <TextBlock Text="{Binding State}" Width="60" Margin="10 0"/>
                                    <TextBlock Text="{Binding Level}" Width="70" Margin="10 0"/>
                                    <TextBlock Text="{Binding Message}" Width="280"/>
                                    <Button Content="删除" Margin="5 0 0 0" Width="60"
                                            Command="{Binding DataContext.DeleteSingleAlarmCommand,
                                                RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 10 0 0">
                        <Button Content="删除选中报警" Command="{Binding DeleteAlarmCommand}" Margin="0 0 5 0"/>
                        <Button Content="清除所有报警" Command="{Binding ClearAllAlarmCommand}" Margin="0 0 5 0"/>
                        <Button Content="导出报警记录" Command="{Binding ExportAlarmCommand}" Margin="0 0 5 0"/>
                        <TextBlock x:Name="AlarmTip" Foreground="Red" VerticalAlignment="Center"
                                   Margin="10 0 0 0" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============ 诊断页 ============ -->
            <TabItem Header="诊断页">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" ItemsSource="{Binding DiagnosisList}"
                              SelectedItem="{Binding SelectedDiagnosis}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              EnableRowVirtualization="True" RowHeight="26">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Width="80"
                                                Binding="{Binding Time,StringFormat='{}{0:HH:mm:ss}'}"/>
                            <DataGridTextColumn Header="从站" Width="90" Binding="{Binding SlaveName}"/>
                            <DataGridTextColumn Header="分类" Width="80" Binding="{Binding Category}"/>
                            <DataGridTextColumn Header="现象" Width="200" Binding="{Binding Symptom}"/>
                            <DataGridTextColumn Header="原因" Width="200" Binding="{Binding Cause}"/>
                            <DataGridTextColumn Header="处置建议" Width="*" Binding="{Binding Suggestion}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 10 0 0">
                        <Button Content="清除诊断记录" Command="{Binding ClearDiagnosisCommand}" Margin="0 0 5 0"/>
                        <Button Content="导出诊断记录" Command="{Binding ExportDiagnosisCommand}" Margin="0 0 5 0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============ 从站页 ============ -->
            <TabItem Header="从站页">
                <Grid Margin="10">
                    <DataGrid ItemsSource="{Binding SlaveStatuses}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="从站号" Width="80" Binding="{Binding SlaveId}"/>
                            <DataGridTextColumn Header="名称" Width="200" Binding="{Binding Name}"/>
                            <DataGridCheckBoxColumn Header="在线" Width="80" Binding="{Binding Online}"/>
                            <DataGridTextColumn Header="最近一帧" Width="120" Binding="{Binding LastSeenText}"/>
                            <DataGridTextColumn Header="连续失败" Width="100" Binding="{Binding Failures}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ============ 配置面板 ============ -->
        <Border Grid.Row="2" Background="White" Margin="10,0,10,10" CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="butConfig" Content="通信配置" Width="120" Height="30"
                            HorizontalAlignment="Center" Click="butConfig_Click" Margin="5"/>
                    <Button x:Name="butConnect" Content="{Binding ConnectButtonText}"
                            Width="120" Height="30" Margin="5"
                            Background="#2c7edb" Foreground="White" BorderThickness="0"
                            Click="butConnect_Click"/>
                </StackPanel>

                <StackPanel x:Name="ConfigPanel" Grid.Row="1" VerticalAlignment="Bottom"
                            Visibility="Collapsed">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="ConfigPanelTransform" Y="60"/>
                    </StackPanel.RenderTransform>

                    <StackPanel Margin="15" Orientation="Horizontal">
                        <StackPanel Margin="0 0 20 0">
                            <TextBlock Text="链路类型" FontSize="14" Foreground="#666"/>
                            <ComboBox Width="170" Height="25"
                                      ItemsSource="{Binding LinkKinds}"
                                      SelectedItem="{Binding SelectedLinkKind}"
                                      DisplayMemberPath="Text"/>
                        </StackPanel>
                        <StackPanel Margin="0 0 20 0">
                            <TextBlock Text="从站地址" FontSize="14" Foreground="#666"/>
                            <TextBox x:Name="txtSlaveId" Width="70" Height="25" Text="{Binding SlaveIdText}"/>
                        </StackPanel>
                        <StackPanel Margin="0 0 20 0">
                            <TextBlock Text="从站名称" FontSize="14" Foreground="#666"/>
                            <TextBox x:Name="txtSlaveName" Width="110" Height="25" Text="{Binding SlaveName}"/>
                        </StackPanel>
                        <StackPanel Margin="0 0 20 0">
                            <TextBlock Text="存储模式" FontSize="14" Foreground="#666"/>
                            <ComboBox Width="150" Height="25"
                                      ItemsSource="{Binding StoreModes}"
                                      SelectedItem="{Binding SelectedStoreMode}"
                                      DisplayMemberPath="Text"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 串口参数：仅在选了串口链路时出现 -->
                    <StackPanel Margin="15,0,15,15" Orientation="Horizontal"
                                Visibility="{Binding IsSerialSelected, Converter={StaticResource BoolToV}}">
                        <StackPanel Margin="0 0 20 0">
                            <TextBlock Text="串口号" FontSize="14" Foreground="#666"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="comPortName" Width="110" Height="25" IsEditable="True"/>
                                <Button Content="刷新" Width="50" Height="25" Margin="4 0 0 0"
                                        Click="butRefreshPort_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="0 0 20 0">
                            <TextBlock Text="波特率" FontSize="14" Foreground="#666"/>
                            <ComboBox x:Name="comBaudRate" Width="100" Height="25" IsEditable="True"
                                      ItemsSource="{Binding BaudRates}" SelectedItem="{Binding BaudRate}"/>
                        </StackPanel>
                        <TextBlock VerticalAlignment="Bottom" Margin="0 0 0 4" Foreground="#999" FontSize="12"
                                   Text="数据位 8 / 停止位 1 / 无校验（Modbus RTU 默认）"/>
                    </StackPanel>

                    <!-- TCP 参数：仅在选了以太网链路时出现 -->
                    <StackPanel Margin="15,0,15,15" Orientation="Horizontal"
                                Visibility="{Binding IsTcpSelected, Converter={StaticResource BoolToV}}">
                        <StackPanel Margin="0 0 20 0">
                            <TextBlock Text="IP / 主机名" FontSize="14" Foreground="#666"/>
                            <TextBox x:Name="txtTcpHost" Width="180" Height="25" Text="{Binding TcpHost}"/>
                        </StackPanel>
                        <StackPanel Margin="0 0 20 0">
                            <TextBlock Text="端口" FontSize="14" Foreground="#666"/>
                            <TextBox x:Name="txtTcpPort" Width="80" Height="25" Text="{Binding TcpPort}"/>
                        </StackPanel>
                        <TextBlock VerticalAlignment="Bottom" Margin="0 0 0 4" Foreground="#999" FontSize="12"
                                   Text="Modbus TCP 默认端口 502"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
