<UserControl x:Class="AirCompressMonitor.Wpf.Control.LedLight"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AirCompressMonitor.Wpf.Control"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="40" x:Name="LedCtrl">

    <!-- 👇 把转换器放到 UserControl 资源里，这是老版本 WPF 最稳定的方式 -->
    <UserControl.Resources>
     <local:LightColorConverter x:Key="LightColorConv"/>
        <local:BoolToDoubleConverter x:Key="BoolToDoubleConv" TrueValue="15" FalseValue="0"/>

    </UserControl.Resources>

    <Grid>
        <Ellipse Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
             <Ellipse.Fill>
                <!-- 👇 用 StaticResource 引用，不再用 {local:Converter} 写法 -->
               <MultiBinding Converter="{StaticResource LightColorConv}">
                    <Binding ElementName="LedCtrl" Path="IsOn"/>
                    <Binding ElementName="LedCtrl" Path="LightColor"/>
                </MultiBinding>
            </Ellipse.Fill>
            <Ellipse.Effect>

                <DropShadowEffect 
                    Color="{Binding ElementName=LedCtrl, Path=LightColor}"
                    BlurRadius="{Binding ElementName=LedCtrl, Path=IsOn, Converter={StaticResource BoolToDoubleConv}}"
                    Opacity="0.8" ShadowDepth="0"/>
            </Ellipse.Effect>
        </Ellipse>
    </Grid>
</UserControl>